{
  "$schema": "../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glacier Launcher",
  "version": "0.1.0",
  "identifier": "com.glacierclient.launcher",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix C:/Users/User/MinecraftLauncher/frontend run dev",
    "beforeBuildCommand": "npm --prefix C:/Users/User/MinecraftLauncher/frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glacier Launcher",
        "width": 880,
        "height": 600,
        "minWidth": 740,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
