<?xml version="1.0" encoding="utf-8"?>
<!-- Glacier's manifest points android:roundIcon at @mipmap/ic_launcher, so
     the app itself never resolves this name. It exists so that @mipmap/
     ic_launcher_round cannot resolve to the merged-in app_pojavlauncher
     library's own round mipmap (Pojav's mascot) from any other reference —
     the library's own manifest and resources still name it, and an :app
     resource of the same name is what shadows the library's copy. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
