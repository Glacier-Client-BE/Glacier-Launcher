<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes getExternalFilesDir(DIRECTORY_DOWNLOADS) (where
     LauncherUpdateService.kt saves the downloaded update APK) to the
     FileProvider declared in AndroidManifest.xml.

     Also exposes GlacierStorage.preferredRoot()'s two possible locations —
     BedrockVersionService.kt's imported-APK folder lives under whichever
     one is currently in use, shared storage when All Files Access is
     granted or the app-private sandbox otherwise (see GlacierStorage.kt's
     doc comment) — since BedrockVersionService.install() hands a file
     under that root to this same FileProvider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="downloads" path="Download/" />
    <external-path name="glacier_shared" path="games/Glacier/" />
    <external-files-path name="glacier_private" path="." />
</paths>
